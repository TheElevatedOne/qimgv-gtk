[Desktop Entry]
Version=1.0
Type=Application
Name=qimgv
GenericName=Image Viewer
Comment=Fast and easy to use image viewer
Exec=qimgv %f
TryExec=qimgv
Icon=qimgv
Terminal=false
StartupNotify=true
StartupWMClass=qimgv
Categories=Graphics;Viewer;GTK;
Keywords=image;view;viewer;picture;photo;gif;jpeg;png;webp;jxl;avif;heic;raw;
MimeType=image/jpeg;image/pjpeg;image/png;image/apng;image/vnd.mozilla.apng;image/gif;image/webp;image/jxl;image/avif;image/avif-sequence;image/heif;image/heic;image/heif-sequence;image/heic-sequence;image/bmp;image/x-bmp;image/x-ms-bmp;image/tiff;image/svg+xml;image/svg+xml-compressed;image/x-icon;image/vnd.microsoft.icon;image/x-tga;image/x-portable-anymap;image/x-portable-bitmap;image/x-portable-graymap;image/x-portable-pixmap;image/x-xpixmap;image/x-xbitmap;image/qoi;image/x-qoi;image/x-dds;image/x-exr;image/x-icns;image/x-dcraw;image/x-adobe-dng;image/x-canon-cr2;image/x-canon-cr3;image/x-canon-crw;image/x-nikon-nef;image/x-nikon-nrw;image/x-sony-arw;image/x-sony-sr2;image/x-sony-srf;image/x-fuji-raf;image/x-olympus-orf;image/x-panasonic-rw2;image/x-panasonic-raw;image/x-pentax-pef;image/x-samsung-srw;image/x-sigma-x3f;image/x-kodak-dcr;image/x-kodak-kdc;image/x-kodak-k25;image/x-minolta-mrw;image/x-epson-erf;image/x-hasselblad-3fr;image/x-phaseone-iiq;image/x-leaf-mos;image/x-mamiya-mef;image/x-raw;
